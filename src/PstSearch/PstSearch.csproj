<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Outlook 2007 為 32 位元，COM 互通必須 x86 -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PstSearchTool</AssemblyName>
    <RootNamespace>PstSearchTool</RootNamespace>
    <Version>1.0.12</Version>
    <Product>Outlook PST 搜尋工具</Product>
    <Description>Outlook 2007 於 Windows 10/11 搜尋失效的外部替代搜尋工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- dynamic（Outlook COM 晚期繫結）需要 Microsoft.CSharp -->
    <Reference Include="Microsoft.CSharp" />
    <!-- 讓 net48 在沒有本機 targeting pack 的機器（如 CI）也能建置 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <!-- SQLite（自建倒排索引僅需標準功能），x86 原生檔自動隨輸出複製 -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

</Project>
